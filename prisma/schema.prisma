generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Comic {
  id           String   @id @default(cuid())
  publisher    String
  series       String
  volume       String   @default("")
  years        String   @default("")
  type         String   @default("")
  issue        String
  issueNumber  Int
  currentValue Float
  collected    Boolean  @default(false)
  isGrail      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Indexes for performance
  @@index([publisher, series, issue])
  @@index([series])
  @@index([collected])
  @@index([isGrail])
  @@index([publisher])
  @@index([issueNumber])
  
  // Composite unique constraint to prevent exact duplicates (including type)
  @@unique([publisher, series, volume, issue, type], name: "publisher_series_volume_issue_type")
  @@map("comics")
}

model FavoriteSeries {
  id        String   @id @default(cuid())
  publisher String
  series    String
  volume    String   @default("")
  dateAdded DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Ensure no duplicate favorite series
  @@unique([publisher, series, volume], name: "publisher_series_volume")
  @@index([publisher, series])
  @@map("favorite_series")
}
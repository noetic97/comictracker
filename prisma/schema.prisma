generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String           @unique
  createdAt      DateTime?        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime?        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastSignInAt   DateTime?        @map("last_sign_in_at") @db.Timestamptz(6)
  displayName    String?          @map("display_name")
  avatarUrl      String?          @map("avatar_url")
  isActive       Boolean?         @default(true) @map("is_active")
  emailVerified  Boolean?         @default(false) @map("email_verified")
  alertLogs      AlertLog[]
  comics         Comic[]
  favoriteSeries FavoriteSeries[]

  @@index([email])
  @@map("users")
}

model Comic {
  id                   String    @id @default(dbgenerated("('c'::text || substr(md5((random())::text), 1, 24))"))
  publisher            String
  series               String
  volume               String    @default("")
  years                String    @default("")
  type                 String    @default("")
  issue                String
  issueNumber          Float     @db.Real
  currentValue         Float
  collected            Boolean   @default(false)
  isGrail              Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @default(now())
  artist               String?
  cert                 String?
  certificationCompany String?
  coverArtist          String?
  coverImageUrl        String?
  dateAdded            DateTime?
  datePurchased        DateTime?
  description          String?
  firstAppearance      String?
  gradeDetails         String?
  issueDate            String?
  letterer             String?
  notes                String?
  pricePaid            Float?
  signed               Boolean   @default(false)
  storageLocation      String?
  storyTitle           String?
  variantDetails       String?
  writer               String?
  grade                String?
  userId               String    @map("user_id") @db.Uuid
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([publisher, series, volume, issue, type, userId], name: "publisher_series_volume_issue_type_user", map: "publisher_series_volume_issue_type_user")
  @@unique([publisher, series, volume, issue, type])
  @@index([userId])
  @@index([publisher, series, issue])
  @@index([series])
  @@index([collected])
  @@index([isGrail])
  @@index([publisher])
  @@index([issueNumber])
  @@index([grade])
  @@index([signed])
  @@index([pricePaid])
  @@index([dateAdded])
  @@index([storageLocation])
  @@map("comics")
}

model FavoriteSeries {
  id        String   @id @default(dbgenerated("('c'::text || substr(md5((random())::text), 1, 24))"))
  publisher String
  series    String
  volume    String   @default("")
  dateAdded DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([publisher, series, volume, userId], name: "publisher_series_volume_user", map: "publisher_series_volume_user")
  @@unique([publisher, series, volume])
  @@index([userId])
  @@index([publisher, series])
  @@map("favorite_series")
}

model AlertLog {
  id           String   @id @default(uuid())
  message      String
  severity     String
  source       String
  metadata     Json?
  telegramSent Boolean  @default(false)
  emailSent    Boolean  @default(false)
  sentAt       DateTime @default(now())
  createdAt    DateTime @default(now())
  userId       String?  @map("user_id") @db.Uuid
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@index([severity])
  @@index([source])
  @@index([sentAt])
  @@map("alert_logs")
}

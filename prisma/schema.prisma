generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
}

model User {
  id             String            @id @default(uuid())
  email          String            @unique
  createdAt      DateTime?         @default(now()) @map("created_at")
  updatedAt      DateTime?         @default(now()) @updatedAt @map("updated_at")
  lastSignInAt   DateTime?         @map("last_sign_in_at")
  displayName    String?           @map("display_name")
  avatarUrl      String?           @map("avatar_url")
  isActive       Boolean?          @default(true) @map("is_active")
  emailVerified  Boolean?          @default(false) @map("email_verified")
  alertLogs      AlertLog[]
  comics         Comic[]
  favoriteSeries FavoriteSeries[]

  @@index([email])
  @@map("users")
}

model Comic {
  id                   String    @id @default(cuid())
  publisher            String
  series               String
  volume               String    @default("")
  years                String    @default("")
  type                 String    @default("")
  issue                String
  issueNumber          Float
  currentValue         Float
  collected            Boolean   @default(false)
  isGrail              Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @default(now())
  artist               String?
  cert                 String?
  certificationCompany String?
  coverArtist          String?
  coverImageUrl        String?
  dateAdded            DateTime?
  datePurchased        DateTime?
  description          String?
  firstAppearance      String?
  gradeDetails         String?
  issueDate            String?
  letterer             String?
  notes                String?
  pricePaid            Float?
  signed               Boolean   @default(false)
  storageLocation      String?
  storyTitle           String?
  variantDetails       String?
  writer               String?
  grade                String?
  grailReason          String?
  userId               String    @map("user_id")
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  // No unique on (publisher, series, volume, issue, type) so we can store multiple copies
  // when grade, pricePaid, dateAdded, or storageLocation differ (see bulk import copyKey)
  @@index([userId])
  @@index([userId, publisher, series, volume, issue, type])
  @@index([publisher, series, issue])
  @@index([series])
  @@index([collected])
  @@index([isGrail])
  @@index([publisher])
  @@index([issueNumber])
  @@index([grade])
  @@index([signed])
  @@index([pricePaid])
  @@index([dateAdded])
  @@index([storageLocation])
  @@map("comics")
}

model FavoriteSeries {
  id        String   @id @default(cuid())
  publisher String
  series    String
  volume    String   @default("")
  dateAdded DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([publisher, series, volume, userId], name: "publisher_series_volume_user")
  @@index([userId])
  @@index([publisher, series])
  @@map("favorite_series")
}

model AlertLog {
  id           String   @id @default(uuid())
  message      String
  severity     String
  source       String
  metadata     String?  // JSON string
  telegramSent Boolean  @default(false)
  emailSent    Boolean  @default(false)
  sentAt       DateTime @default(now())
  createdAt    DateTime @default(now())
  userId       String?  @map("user_id")
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@index([severity])
  @@index([source])
  @@index([sentAt])
  @@map("alert_logs")
}

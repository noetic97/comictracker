# Database (SQLite)
DATABASE_URL="file:./prisma/dev.db"

# Default user (single-tenant)
DEFAULT_USER_EMAIL="user@comictracker.local"

# Server
PORT=3001
NODE_ENV=development

# Optional: Alerts (Telegram / SendGrid)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# SENDGRID_API_KEY=
# ALERT_EMAIL_TO=
# ALERT_EMAIL_FROM=

# Client (Vite) – optional override for API base URL
# VITE_API_BASE_URL=/api
# VITE_LOG_LEVEL=debug

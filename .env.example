# Database (SQLite)
DATABASE_URL="file:./prisma/dev.db"

# Default user (single-tenant)
DEFAULT_USER_EMAIL="user@comictracker.local"

# Server (production / systemd: use 3001 so the built app is at http://localhost:3001)
PORT=3001
NODE_ENV=development

# --- Ports: prod service vs local dev ---
# Built app (npm run build:prod + npm start or systemd): http://localhost:3001 (UI + /api). Not :3000.
# npm run dev (default): UI http://localhost:3000, dev API http://localhost:3002 (Vite proxies /api → 3002).
#   Safe alongside systemd on 3001 if you use WAL + busy_timeout (enabled in code for file: URLs). Writes are still
#   serialized by SQLite—two processes sharing one DB wait on locks rather than corrupting; heavy concurrent writes can stall.
# npm run dev:api-3001: classic dev with API on 3001 — only when nothing else uses 3001 (e.g. systemd stopped).

# Optional: Alerts (Telegram / SendGrid)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# SENDGRID_API_KEY=
# ALERT_EMAIL_TO=
# ALERT_EMAIL_FROM=

# Client (Vite) — for dev, put these in client/.env.development.local (Vite cwd is client/)
# VITE_API_PORT=3002   # proxy /api to this port (default 3001); match dev:api-3002 / PORT on the API process
# VITE_API_BASE_URL=/api   # leave unset for normal dev (proxy) and prod (same origin)
# VITE_LOG_LEVEL=debug

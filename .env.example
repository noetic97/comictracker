# Database (SQLite)
DATABASE_URL="file:./prisma/dev.db"

# Default user (single-tenant)
DEFAULT_USER_EMAIL="user@comictracker.local"

# Server (production / systemd: use 3001 so the built app is at http://localhost:3001)
PORT=3001
NODE_ENV=development

# --- Ports: prod service vs local dev ---
# Built app (npm run build:prod + npm start or systemd): http://localhost:3001 (UI + /api). Not :3000.
# npm run dev (default): UI http://localhost:3000, dev API http://localhost:3002 (Vite proxies /api → 3002).
#   Safe alongside systemd on 3001 if you use WAL + busy_timeout (enabled in code for file: URLs). Writes are still
#   serialized by SQLite—two processes sharing one DB wait on locks rather than corrupting; heavy concurrent writes can stall.
# npm run dev:api-3001: classic dev with API on 3001 — only when nothing else uses 3001 (e.g. systemd stopped).

# Optional: Alerts (Telegram / SendGrid)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# SENDGRID_API_KEY=
# ALERT_EMAIL_TO=
# ALERT_EMAIL_FROM=

# Client (Vite) — envDir is the repo root (see client/vite.config.ts), so VITE_* can live HERE next to PORT/DATABASE_URL.
# You can still use client/.env.development.local for overrides if you prefer.
# VITE_API_PORT=3002   # proxy /api to this port (default 3001); match dev:api-3002 / PORT on the API process
# VITE_API_BASE_URL=/api   # leave unset for normal dev (proxy) and prod (same origin)
# VITE_LOG_LEVEL=debug
#
# --- Optional file logging & browser crash diagnostics ---
# Mirror Node console to a file (systemd journal still gets stdout/stderr too).
# LOG_FILE=logs/comictracker.log
#
# Accept POST /api/debug/client-log from the SPA (errors, heartbeats, mirrored console). Use a dedicated file
# if you do not want client JSON mixed with server text logs:
# ENABLE_CLIENT_LOG_INGEST=true
# CLIENT_LOG_FILE=logs/comictracker-client.log
# If CLIENT_LOG_FILE is unset, client lines go to LOG_FILE when set, else logs/client-ingress.log
#
# Client opt-in (either is enough):
#   VITE_ENABLE_CLIENT_LOG=true   # in this file (repo root) or client/.env* — rebuild production after changing
#   or in the browser: localStorage.setItem("comictracker_remote_log","1"); location.reload();
#
# iPhone Safari: Settings → Safari → Advanced → Web Inspector ON; on Mac enable Safari Develop menu;
# USB-connect the phone → Safari → Develop → [device] → [page] for Console / errors.
# Firefox iOS uses WebKit — same Web Inspector attachment as Safari when using Safari on Mac for remote inspection
# of third-party browsers is limited; prefer Safari on iOS for deep debugging or reproduce on Firefox desktop.

    "eslint": "^8.57.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "eslint-plugin-unused-imports": "^4.1.3",
    "jsdom": "^25.0.0",
    "ts-prune": "^0.10.3",
    "typescript": "^5.6.0",
    "vite": "^5.4.6",
    "vitest": "^2.1.0"

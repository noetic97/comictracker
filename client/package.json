{
  "name": "comictracker",
  "homepage": "https://noetic97.github.io/comictracker/",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite --host --port 3000 --no-open",
